+        .arrived = reinterpret_cast<const std::uint64_t*>(flags + kArrived),
+        .value = operation + 1,
+        .timed_out = reinterpret_cast<std::uint32_t*>(flags + kTimedOut),
+        .wait_ticks = wait_ticks_,
+        .release = release_[window],
+        .wire_bytes = (bytes + kFrame - 1) & ~(kFrame - 1),
+    };
