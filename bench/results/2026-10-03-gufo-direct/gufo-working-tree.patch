+  DonnerkeuleConfig config_;
+  int device_{-1}, send_fd_{-1}, recv_fd_{-1};
+  void* send_{nullptr};
+  void* recv_{nullptr};
+  void* flags_{nullptr};
+  void* flags_device_{nullptr};
+  std::array<hipEvent_t, kWindows> release_{};
+  std::uint64_t wait_ticks_{0}, next_operation_{0}, dma_sequence_{0};
+  std::optional<std::uint64_t> scope_;
+  std::unique_ptr<Socket> control_;
+  std::thread worker_;
+  mutable std::mutex mutex_;
+  std::condition_variable jobs_ready_;
+  std::deque<Job> jobs_;
+  std::size_t queued_{0};
+  std::string failure_;
+  std::atomic<bool> stopping_{false};
+  std::atomic<std::uint64_t> payload_bytes_{0}, dma_batches_{0};
+  bool initialized_{false};
+};
