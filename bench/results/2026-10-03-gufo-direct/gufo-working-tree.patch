+bool Executor::CompleteReduce(float* output, std::size_t rows,
+                              const Communicator::QueuedPartial& lease,
+                              std::string* error, bool observe,
+                              bool defer_wait) const {
+  if (!lease.send)
+    return AllReduce(output, rows, error, observe);
+  const std::size_t count = rows * config().hidden_size;
+  const std::size_t bytes = count * sizeof(float);
+  if (lease.wire_bytes < bytes || !lease.release) {
+    AssignError(error, "invalid direct all-reduce lease");
+    return false;
+  }
+  // Ragged tensor tails never expose old payload bytes on the wire.
+  if (lease.wire_bytes > bytes &&
+      !Check(hipMemsetAsync(reinterpret_cast<char*>(lease.send) + bytes, 0,
+                            lease.wire_bytes - bytes, stream_),
+             "direct all-reduce tail clear", error))
+    return false;
+  // The timing-enabled system marker completes all producer writes before
+  // the following GPU flag wakes the CPU transport worker. The RX pool is
+  // uncached so an already queued consumer sees external DMA after WaitValue.
+  if (!Check(hipEventRecord(lease.release, stream_),
+             "direct all-reduce system release", error))
+    return false;
+  PublishPartial(lease.ready, lease.value, stream_);
+  if (!defer_wait)
+    FinishDirectReduce(output, rows, lease, observe);
+  return true;
+}
+
+void Executor::FinishDirectReduce(float* output, std::size_t rows,
+                                  const Communicator::QueuedPartial& lease,
+                                  bool observe) const {
+  const std::size_t count = rows * config().hidden_size;
+  WaitValue(lease.arrived, lease.value, lease.wait_ticks, lease.timed_out,
+            stream_);
+  SumPartials(lease.send, lease.peer, output, count, stream_);
+  if (observe && options_.moe_observer)
+    options_.moe_observer(output, count * sizeof(float), stream_);
+}
