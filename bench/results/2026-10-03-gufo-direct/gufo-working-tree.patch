+      if (++spins % 4096 == 0)
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+      else
+        __builtin_ia32_pause();
+    }
+    if (stopping_.load(std::memory_order_relaxed)) {
+      SetError(error, "Donnerkeule producer stopped");
+      return false;
+    }
+    return true;
+  }
+  bool WaitDma(unsigned direction, const tbv_gpu_transfer& transfer,
+               std::string* error) {
+    tbv_gpu_wait wait{};
+    wait.direction = direction;
+    wait.timeout_ms = 30000;
+    wait.sequence = transfer.sequence;
+    if (::ioctl(device_, TBV_GPU_WAIT, &wait) != 0) {
+      SetError(error, SystemError("Donnerkeule wait"));
+      return false;
+    }
+    if (wait.status || wait.completed_bytes != transfer.bytes) {
+      SetError(error,
+               "Donnerkeule DMA failed: status=" + std::to_string(wait.status));
+      return false;
+    }
+    return true;
+  }
+  bool Transfer(const Job& job, std::string* error) {
+    const std::size_t padded = (job.bytes + kFrame - 1) & ~(kFrame - 1);
+    const std::size_t base = (job.operation % kWindows) * kWindow;
+    const std::size_t limit = config_.rails * 512 * kFrame;
+    if (!padded)
+      return Control(3, job.scope, job.operation, 0, 0, 0, 0, error);
+    for (std::size_t done = 0; done < padded;) {
+      const std::size_t bytes = std::min(limit, padded - done);
+      tbv_gpu_transfer transfer{++dma_sequence_, base + done, bytes};
+      if (::ioctl(device_, TBV_GPU_PREPARE_RX, &transfer) != 0) {
+        SetError(error, SystemError("Donnerkeule prepare RX"));
+        return false;
+      }
+      if (!Control(1, job.scope, job.operation, job.bytes, transfer.offset,
+                   transfer.bytes, transfer.sequence, error))
+        return false;
+      if (::ioctl(device_, TBV_GPU_SUBMIT_TX, &transfer) != 0) {
+        SetError(error, SystemError("Donnerkeule submit TX"));
+        return false;
+      }
+      if (!WaitDma(TBV_GPU_TX, transfer, error) ||
+          !WaitDma(TBV_GPU_RX, transfer, error))
+        return false;
+      done += bytes;
+      dma_batches_.fetch_add(1, std::memory_order_relaxed);
+    }
+    payload_bytes_.fetch_add(job.bytes, std::memory_order_relaxed);
+    return true;
+  }
+  void Work() {
+    for (;;) {
+      Job job{};
+      {
+        std::unique_lock lock(mutex_);
+        jobs_ready_.wait(lock,
+                         [this] { return stopping_.load() || !jobs_.empty(); });
