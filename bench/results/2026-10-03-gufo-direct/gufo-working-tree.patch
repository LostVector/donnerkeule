+private:
+  struct Job {
+    std::uint64_t scope, operation;
+    std::size_t bytes;
+  };
+  template<class T>
+  std::atomic_ref<T> Flag(std::size_t offset) const {
+    return std::atomic_ref<T>(
+        *reinterpret_cast<T*>(static_cast<std::uint8_t*>(flags_) + offset));
+  }
+  bool Allocate(void** data, int* fd, bool uncached, std::string* error) {
+    if (!Hip(uncached
+                 ? hipExtMallocWithFlags(data, kPool, hipDeviceMallocUncached)
+                 : hipMalloc(data, kPool),
+             "DMA pool allocation", error) ||
+        !Hip(hipMemset(*data, 0, kPool), "DMA pool initialization", error) ||
+        !Hip(hipDeviceSynchronize(), "DMA pool initialization fence", error))
+      return false;
+    hipDeviceptr_t base = 0;
+    std::size_t size = 0;
+    if (!Hip(hipMemGetAddressRange(&base, &size,
+                                   reinterpret_cast<hipDeviceptr_t>(*data)),
+             "DMA pool allocation range", error))
+      return false;
+    if (base != reinterpret_cast<hipDeviceptr_t>(*data) || size != kPool) {
+      SetError(error,
+               "Donnerkeule needs a dedicated exact-size HIP allocation");
+      return false;
+    }
+    return Hip(hipMemGetHandleForAddressRange(fd, base, kPool,
+                                              hipMemRangeHandleTypeDmaBufFd, 0),
+               "HIP DMA-BUF export", error);
+  }
+  bool Check(std::string* error) const {
+    if (initialized_ && failure_.empty())
+      return true;
+    SetError(error,
+             failure_.empty() ? "Donnerkeule is not initialized" : failure_);
+    return false;
+  }
+  // mutex_ held. Stop DMA before releasing queued GPU waits: their producers
+  // may reuse pool windows while unwinding the failed operation.
+  bool Fail(std::string* error, std::string message) {
+    if (failure_.empty())
+      failure_ =
+          message.empty() ? "Donnerkeule exchange failed" : std::move(message);
+    if (device_ >= 0)
+      (void)::ioctl(device_, TBV_GPU_ABORT);
+    if (flags_device_)
+      Flag<std::uint64_t>(kArrived).store(UINT64_MAX,
+                                          std::memory_order_release);
+    SetError(error, failure_);
+    return false;
+  }
+  bool Control(std::uint64_t phase, std::uint64_t scope,
+               std::uint64_t operation, std::uint64_t bytes,
+               std::uint64_t offset, std::uint64_t chunk,
+               std::uint64_t sequence, std::string* error) {
+    const std::array<std::uint64_t, 8> local{
+        kControlMagic, phase, scope, operation, bytes, offset, chunk, sequence};
+    std::array<std::uint64_t, 8> remote{};
+    if (!control_->SendAll(local.data(), sizeof(local), error) ||
+        !control_->RecvAll(remote.data(), sizeof(remote), error))
+      return false;
+    if (local != remote) {
+      SetError(error, "Donnerkeule collective scope/ordinal/shape mismatch");
+      return false;
+    }
+    return true;
+  }
+  bool WaitReady(std::uint64_t value, std::string* error) {
+    const auto deadline = std::chrono::steady_clock::now() + kExchangeTimeout;
+    unsigned spins = 0;
+    while (Flag<std::uint64_t>(kReady).load(std::memory_order_acquire) <
+           value) {
+      if (stopping_.load(std::memory_order_relaxed) ||
+          std::chrono::steady_clock::now() >= deadline) {
+        SetError(error, "Donnerkeule producer stopped or timed out");
+        return false;
