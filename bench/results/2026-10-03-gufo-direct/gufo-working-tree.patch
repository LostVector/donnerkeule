+                                            std::memory_order_release);
+    }
+  }
+  void Cleanup() noexcept {
+    stopping_.store(true);
+    if (control_)
+      (void)::shutdown(control_->fd(), SHUT_RDWR);
+    // ABORT wakes any kernel WAIT and drains every descriptor before the GPU
+    // is released. The worker never frees or dereferences HIP payload data.
+    if (device_ >= 0)
+      (void)::ioctl(device_, TBV_GPU_ABORT);
+    if (flags_device_)
+      Flag<std::uint64_t>(kArrived).store(UINT64_MAX,
+                                          std::memory_order_release);
