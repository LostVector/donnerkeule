+// Two-host head-gather correctness probe. Uses real registered host windows;
+// the independent CPU oracle is row-wise rank0/rank1 concatenation.
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "src/models/qwen38_flash_next/kernels/rocm/executor.hpp"
+#include "src/models/qwen38_flash_next/kernels/rocm/verbs.hpp"
+
+namespace q = gufo::models::qwen38_flash_next::rocm;
+namespace {
+void Require(bool value, const char* what) {
+  if (!value)
+    throw std::runtime_error(what);
+}
+void Check(hipError_t result) {
+  if (result != hipSuccess)
+    throw std::runtime_error(hipGetErrorString(result));
+}
+std::uint32_t Pattern(std::uint32_t rank, std::uint32_t row, std::size_t i,
+                      std::uint32_t repetition) {
+  if (i % 97 == 0)
+    return 0x80000000U;
+  if (i % 97 == 1)
+    return 0x7fc01234U + rank;
+  return 0x3f000000U |
+         ((rank * 123457U + row * 65537U + i * 31U + repetition * 7919U) &
+          0x7fffffU);
+}
+struct DeviceBuffer {
+  float* data = nullptr;
+  explicit DeviceBuffer(std::size_t count) {
+    Check(hipMalloc(&data, count * sizeof(float)));
+  }
+  ~DeviceBuffer() { (void)hipFree(data); }
+};
+}  // namespace
+
+int main(int argc, char** argv) {
+  try {
+    Require(argc == 4,
+            "usage: gufo_head_gather_probe rank head-ip rdma-device");
+    const auto rank = static_cast<std::uint32_t>(std::stoul(argv[1]));
+    Require(rank < 2, "rank must be 0 or 1");
+    Check(hipSetDevice(0));
+    q::IbrverbsConfig config;
+    config.rank = rank;
+    config.bootstrap_host = argv[2];
+    config.bootstrap_port = 29627;
+    config.rdma_device = argv[3];
+    std::string error;
+    auto comm = q::CreateIbrverbsCommunicator(config, &error);
+    if (!comm)
+      throw std::runtime_error(error);
+    auto gather = q::Executor::TwoRankHeadGather(comm);
+    hipStream_t stream{};
+    Check(hipStreamCreateWithFlags(&stream, hipStreamNonBlocking));
+    std::uint64_t scope = 1000;
+    std::size_t cases = 0;
+    for (const std::uint32_t rows : {1U, 2U}) {
+      for (const std::size_t half : {1U, 32U, 257U, 65537U, 124160U}) {
+        const auto count = std::size_t(rows) * half * 2;
+        DeviceBuffer buffer(count + 16);
+        std::vector<std::uint32_t> input(count + 16, 0xcdcdcdcdU);
+        std::vector<std::uint32_t> actual(count + 16);
+        for (std::uint32_t rep = 0; rep < 4; ++rep) {
+          std::fill(input.begin(), input.end(), 0xcdcdcdcdU);
+          for (std::uint32_t row = 0; row < rows; ++row)
+            for (std::size_t i = 0; i < half; ++i)
+              input[std::size_t(row) * half + i] = Pattern(rank, row, i, rep);
+          Check(hipMemcpyAsync(buffer.data, input.data(), input.size() * 4,
+                               hipMemcpyHostToDevice, stream));
+          if (!comm->BeginOperation(scope, &error))
+            throw std::runtime_error(error);
+          if (!gather(buffer.data, half, rows, stream, &error))
+            throw std::runtime_error(error);
+          Check(hipStreamSynchronize(stream));
+          if (!comm->CheckQueued(&error))
+            throw std::runtime_error(error);
+          if (!comm->EndOperation(scope++, &error))
+            throw std::runtime_error(error);
+          Check(hipMemcpy(actual.data(), buffer.data, actual.size() * 4,
+                          hipMemcpyDeviceToHost));
+          for (std::uint32_t row = 0; row < rows; ++row)
+            for (std::uint32_t peer = 0; peer < 2; ++peer)
+              for (std::size_t i = 0; i < half; ++i)
+                Require(actual[(std::size_t(row) * 2 + peer) * half + i] ==
+                            Pattern(peer, row, i, rep),
+                        "CPU concatenation oracle mismatch");
+          for (std::size_t i = count; i < actual.size(); ++i)
+            Require(actual[i] == 0xcdcdcdcdU, "output guard overwritten");
+          ++cases;
+        }
+      }
+    }
+    Check(hipStreamDestroy(stream));
+    std::printf("rank=%u cases=%zu bitwise_concat=pass guards=pass\n", rank,
+                cases);
+    return 0;
+  } catch (const std::exception& error) {
+    std::fprintf(stderr, "%s\n", error.what());
+    return 1;
+  }
+}
