+// Isolated experiment: retain full allocation, shard one/two-row Q8 heads.
+// Larger batches keep the baseline path because measured communication costs
+// erase the gain or worsen tails. No graph/collective protocol is changed.
+bool Executor::HeadProjection(const float* x, float* out, std::uint32_t rows,
+                              std::string* error, bool batched) const {
+  const auto& full = model_->output();
+  if (model_->tp_world_size() != 2 || (rows != 1 && rows != 2) ||
+      full.type != core::GgmlType::kQ8_0 || full.rows != 248320 ||
+      full.cols != 2560 || config().hidden_size != 2560) {
+    return batched ? DenseBatch(full, x, out, rows, error)
+                   : Dense(full, x, out, rows, error);
+  }
+  const auto rank = model_->tp_rank();
+  if (rank >= 2) {
+    if (error)
+      *error = "experimental output-head rank out of range";
+    return false;
+  }
+  constexpr std::size_t kQ8BlockValues = 32, kQ8BlockBytes = 34;
+  DeviceTensor part = full;
+  part.rows /= 2;
+  part.data = static_cast<std::uint8_t*>(full.data) +
+              std::size_t{rank} * part.rows * (full.cols / kQ8BlockValues) *
+                  kQ8BlockBytes;
+  if (!Dense(part, x, out, rows, error))
+    return false;
+  if (!options_.head_gather) {
+    AssignError(error, "experimental head gather callback is missing");
+    return false;
+  }
+  return options_.head_gather(out, part.rows, rows, stream_, error);
+}
