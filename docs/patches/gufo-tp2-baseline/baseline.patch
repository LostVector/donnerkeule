diff --git a/src/models/qwen38_flash_next/kernels/rocm/tp_trace.hpp b/src/models/qwen38_flash_next/kernels/rocm/tp_trace.hpp
new file mode 100644
index 0000000..67429fa
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/tp_trace.hpp
@@ -0,0 +1,177 @@
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TP_TRACE_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TP_TRACE_HPP_
+
+// Investigation-only, bounded telemetry. Compile without GUFO_TP_TRACE to erase
+// the instrumentation. No logging, allocation or additional locks per exchange.
+#include <unistd.h>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <new>
+#include <string>
+
+namespace gufo::models::qwen38_flash_next::rocm {
+class TpTrace {
+public:
+  enum Stage : std::size_t {
+    kEnter,
+    kLocked,
+    kJobPublished,
+    kQueued,
+    kWorker,
+    kWorkerChecked,
+    kReady,
+    kPostBegin,
+    kPostEnd,
+    kPeerCq,
+    kSendCq,
+    kPriorSendsRetired,
+    kTransferDone,
+    kPublished,
+    kFailure,
+    kStageCount
+  };
+  inline static constexpr std::array<const char*, kStageCount> kNames = {
+      "queue_enter_ns",        "queue_locked_ns",      "job_published_ns",
+      "queue_done_ns",         "worker_dequeued_ns",   "worker_checked_ns",
+      "gpu_ready_observed_ns", "post_begin_ns",        "post_end_ns",
+      "peer_cq_observed_ns",   "send_cq_observed_ns",  "prior_sends_retired_ns",
+      "transfer_validated_ns", "arrival_published_ns", "failure_ns"};
+  explicit TpTrace(std::uint32_t rank) {
+#ifdef GUFO_TP_TRACE
+    const char* prefix = std::getenv("GUFO_TP_TRACE_PREFIX");
+    if (prefix == nullptr || *prefix == '\0')
+      return;
+    constexpr std::size_t kDefaultCapacity = 65536;
+    capacity_ = kDefaultCapacity;
+    if (const char* value = std::getenv("GUFO_TP_TRACE_CAPACITY")) {
+      char* end = nullptr;
+      const auto parsed = std::strtoull(value, &end, 10);
+      if (end == value || *end != '\0' || parsed == 0 || parsed > 1048576) {
+        std::fprintf(
+            stderr, "TP trace: invalid bounded capacity; telemetry disabled\n");
+        capacity_ = 0;
+        return;
+      }
+      capacity_ = static_cast<std::size_t>(parsed);
+    }
+    path_ = std::string(prefix) + ".rank" + std::to_string(rank) + ".pid" +
+            std::to_string(static_cast<unsigned long>(::getpid())) + ".csv";
+    records_.reset(new (std::nothrow) Record[capacity_]);
+    if (!records_) {
+      std::fprintf(stderr, "TP trace: allocation failed; telemetry disabled\n");
+      capacity_ = 0;
+    }
+#else
+    (void)rank;
+#endif
+  }
+  [[nodiscard]] std::uint64_t Now() const noexcept {
+#ifdef GUFO_TP_TRACE
+    if (records_)
+      return Clock();
+#endif
+    return 0;
+  }
+  void Begin(std::uint64_t operation, std::uint64_t scope, std::size_t bytes,
+             std::uint64_t enter, std::uint64_t locked) noexcept {
+#ifdef GUFO_TP_TRACE
+    if (!records_)
+      return;
+    if (operation >= capacity_) {
+      dropped_.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    auto& r = records_[operation];
+    r.scope = scope;
+    r.bytes = bytes;
+    // Do not clear timestamps: a peer CQ can be observed one operation early.
+    r.ns[kEnter].store(enter, std::memory_order_relaxed);
+    r.ns[kLocked].store(locked, std::memory_order_relaxed);
+    r.begun.store(true, std::memory_order_release);
+#else
+    (void)operation;
+    (void)scope;
+    (void)bytes;
+    (void)enter;
+    (void)locked;
+#endif
+  }
+  void Stamp(std::uint64_t operation, Stage stage) noexcept {
+#ifdef GUFO_TP_TRACE
+    if (records_ && operation < capacity_) {
+      auto& slot = records_[operation].ns[stage];
+      std::uint64_t empty = 0;
+      // First observation wins, including an early completion.
+      slot.compare_exchange_strong(empty, Clock(), std::memory_order_relaxed);
+    }
+#else
+    (void)operation;
+    (void)stage;
+#endif
+  }
+  // Call only after producers/worker are quiescent. Never dump under a hot
+  // lock.
+  void Dump() noexcept {
+#ifdef GUFO_TP_TRACE
+    if (!records_ || dumped_)
+      return;
+    dumped_ = true;
+    // Exclusive creation avoids overwriting a trace from another communicator.
+    FILE* file = std::fopen(path_.c_str(), "wx");
+    if (file == nullptr) {
+      std::perror("TP trace output");
+      return;
+    }
+    std::fprintf(file, "operation,scope,bytes");
+    for (const auto* name : kNames)
+      std::fprintf(file, ",%s", name);
+    std::fprintf(file, "\n");
+    for (std::size_t i = 0; i < capacity_; ++i) {
+      const auto& r = records_[i];
+      if (!r.begun.load(std::memory_order_acquire))
+        continue;
+      std::fprintf(file, "%zu,%llu,%llu", i,
+                   static_cast<unsigned long long>(r.scope),
+                   static_cast<unsigned long long>(r.bytes));
+      for (const auto& stamp : r.ns)
+        std::fprintf(file, ",%llu",
+                     static_cast<unsigned long long>(
+                         stamp.load(std::memory_order_relaxed)));
+      std::fprintf(file, "\n");
+    }
+    std::fclose(file);
+    std::fprintf(stderr, "TP trace: %s capacity=%zu dropped=%llu\n",
+                 path_.c_str(), capacity_,
+                 static_cast<unsigned long long>(dropped_.load()));
+#endif
+  }
+
+private:
+#ifdef GUFO_TP_TRACE
+  static std::uint64_t Clock() noexcept {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+  }
+  static_assert(std::atomic<std::uint64_t>::is_always_lock_free);
+  struct Record {
+    std::uint64_t scope{0}, bytes{0};
+    std::array<std::atomic<std::uint64_t>, kStageCount> ns{};
+    std::atomic<bool> begun{false};
+  };
+  std::unique_ptr<Record[]> records_;
+  std::string path_;
+  std::size_t capacity_{0};
+  std::atomic<std::uint64_t> dropped_{0};
+  bool dumped_{false};
+#endif
+};
+}  // namespace gufo::models::qwen38_flash_next::rocm
+#endif
